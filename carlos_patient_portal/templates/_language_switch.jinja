{# The language buttons for every page except MFA (which posts its own, see mfa.jinja). Real
   links, not modal triggers: an untranslated string renders in English via the per-key fallback
   in i18n.portal_text, but the choice is applied and remembered. Each button carries its
   language's `lang`, so a screen reader names it in that language. #}
<nav class="language-switch" aria-label="{{ text.language_aria_label }}">
  {% for language in supported_locales %}
    {% if language.is_selected %}
      <span class="text-tab selected" aria-current="true" lang="{{ language.code }}"
      >{{ language.short_label }}</span>
    {% else %}
      <a
        class="text-tab"
        href="{{ url_for('select_locale', locale_code=language.code).path }}?next={{ locale_switch_target | urlencode }}"
        rel="nofollow"
        lang="{{ language.code }}"
        title="{{ language.label }}"
      >{{ language.short_label }}</a>
    {% endif %}
  {% endfor %}
</nav>
