# Copy to deploy/maintenance.env and set mode 0600. Only one-shot maintenance containers receive
# this audit-deletion credential; web and outbox must never receive it.
PATIENT_PORTAL_MAINTENANCE_DATABASE_URL=postgresql+psycopg://portal_audit_maintenance:replace-maintenance-password@database.example.ca:5432/carlos_portal?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.pem
