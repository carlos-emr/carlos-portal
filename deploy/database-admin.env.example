# Copy to deploy/database-admin.env and set mode 0600. This non-superuser login must directly own
# the portal database and be a member of PORTAL_SCHEMA_OWNER_ROLE so it can change grants, table
# ownership, and that role's default privileges. Supply it only to the one-shot policy container.
DATABASE_ADMIN_URL=postgresql://portal_database_admin:replace-admin-password@database.example.ca:5432/carlos_portal?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.pem
PORTAL_SCHEMA_OWNER_ROLE=portal_schema_owner
PORTAL_RUNTIME_ROLE=portal_runtime
PORTAL_MAINTENANCE_ROLE=portal_audit_maintenance
