# Copy to deploy/production.env, set mode 0600, and replace every replace-* value.
# A secret manager may materialize this file immediately before deployment. Never commit it.
PATIENT_PORTAL_ENVIRONMENT=production
PATIENT_PORTAL_CLINIC_ID=replace-clinic-id
PATIENT_PORTAL_CLINIC_NAME=Replace Clinic Name
PATIENT_PORTAL_CLINIC_TIMEZONE=America/Toronto
PATIENT_PORTAL_PUBLIC_BASE_URL=https://portal.example.ca

# The runtime role has ordinary DML plus SELECT/INSERT-only audit access. Percent-encode reserved
# URL characters in credentials. Remote production connections require sslmode=verify-full.
PATIENT_PORTAL_DATABASE_URL=postgresql+psycopg://portal_runtime:replace-runtime-password@database.example.ca:5432/carlos_portal?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.pem
PATIENT_PORTAL_DATABASE_SCHEMA_OWNER_ROLE=portal_schema_owner
PATIENT_PORTAL_DATABASE_MAINTENANCE_ROLE=portal_audit_maintenance
PATIENT_PORTAL_DATABASE_POOL_SIZE=5
PATIENT_PORTAL_DATABASE_MAX_OVERFLOW=5

# Host nginx reaches the container through the deterministic bridge gateway. If
# PORTAL_DOCKER_SUBNET changes, update this exact /32 as well.
PATIENT_PORTAL_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
PATIENT_PORTAL_TRUSTED_PROXY_CIDRS=172.30.80.1/32

# Generate distinct values with at least 32 random characters for every secret below.
PATIENT_PORTAL_SESSION_SECRET=replace-session-secret
PATIENT_PORTAL_IDENTITY_PROOF_SECRET=replace-identity-proof-secret
PATIENT_PORTAL_AUDIT_HASH_SECRET=replace-audit-hash-secret
PATIENT_PORTAL_INTERNAL_HEALTH_TOKEN=replace-health-token
PATIENT_PORTAL_INTERNAL_API_TOKEN=replace-internal-api-token
PATIENT_PORTAL_INTERNAL_STAFF_ASSERTION_PUBLIC_KEYRING={"initial":"replace-with-carlos-ed25519-public-key"}
PATIENT_PORTAL_OUTBOX_ENCRYPTION_KEYRING={"initial":"replace-outbox-encryption-key"}
PATIENT_PORTAL_OUTBOX_ACTIVE_KEY_ID=initial
PATIENT_PORTAL_UNLOCK_SECRET_ENCRYPTION_KEYRING={"initial":"replace-unlock-encryption-key"}
PATIENT_PORTAL_UNLOCK_SECRET_ACTIVE_KEY_ID=initial

PATIENT_PORTAL_SMTP_HOST=smtp.example.ca
PATIENT_PORTAL_SMTP_PORT=587
PATIENT_PORTAL_SMTP_FROM_ADDRESS=no-reply@example.ca
PATIENT_PORTAL_SMTP_STARTTLS=true
PATIENT_PORTAL_SMTP_USERNAME=replace-smtp-username
PATIENT_PORTAL_SMTP_PASSWORD=replace-smtp-password

PATIENT_PORTAL_SMS_WEBHOOK_URL=https://sms.example.ca/send
PATIENT_PORTAL_SMS_WEBHOOK_TOKEN=replace-sms-webhook-token
PATIENT_PORTAL_SMS_SENDER_ID=CARLOS

# Keep the development API disabled. Production validation keeps MFA enabled even if this line is
# accidentally changed.
PATIENT_PORTAL_ENABLE_DEV_ADMIN=false
PATIENT_PORTAL_REQUIRE_MFA=true
