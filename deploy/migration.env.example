# Copy to deploy/migration.env and set mode 0600. This file configures only the environment and
# database URL for the one-shot migration container; it must not contain runtime encryption secrets.
PATIENT_PORTAL_ENVIRONMENT=production
PATIENT_PORTAL_DATABASE_URL=postgresql+psycopg://portal_schema_owner:replace-owner-password@database.example.ca:5432/carlos_portal?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.pem
