# Copy to deploy/outbox.env and set mode 0600. This long-lived worker receives only the database,
# message-delivery, reset-token, and outbox-encryption settings it needs. Do not copy web-only
# identity-proof, audit-hash, internal-API, SMS, or unlock-secret credentials into this file.
PATIENT_PORTAL_ENVIRONMENT=production
PATIENT_PORTAL_CLINIC_ID=replace-clinic-id
PATIENT_PORTAL_CLINIC_NAME=Replace Clinic Name
PATIENT_PORTAL_PUBLIC_BASE_URL=https://portal.example.ca
PATIENT_PORTAL_DATABASE_URL=postgresql+psycopg://portal_runtime:replace-runtime-password@database.example.ca:5432/carlos_portal?sslmode=verify-full&sslrootcert=/run/secrets/postgresql-ca.pem
PATIENT_PORTAL_DATABASE_SCHEMA_OWNER_ROLE=portal_schema_owner
PATIENT_PORTAL_DATABASE_MAINTENANCE_ROLE=portal_audit_maintenance
PATIENT_PORTAL_DATABASE_POOL_SIZE=5
PATIENT_PORTAL_DATABASE_MAX_OVERFLOW=5
PATIENT_PORTAL_SESSION_SECRET=replace-session-secret
PATIENT_PORTAL_OUTBOX_ENCRYPTION_KEYRING={"initial":"replace-outbox-encryption-key"}
PATIENT_PORTAL_OUTBOX_ACTIVE_KEY_ID=initial
PATIENT_PORTAL_OUTBOX_MAX_ATTEMPTS=14
PATIENT_PORTAL_OUTBOX_LEASE_SECONDS=300
PATIENT_PORTAL_OUTBOX_POLL_SECONDS=5
PATIENT_PORTAL_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PATIENT_PORTAL_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PATIENT_PORTAL_SMTP_HOST=smtp.example.ca
PATIENT_PORTAL_SMTP_PORT=587
PATIENT_PORTAL_SMTP_FROM_ADDRESS=no-reply@example.ca
PATIENT_PORTAL_SMTP_STARTTLS=true
PATIENT_PORTAL_SMTP_USERNAME=replace-smtp-username
PATIENT_PORTAL_SMTP_PASSWORD=replace-smtp-password
PATIENT_PORTAL_SMTP_TIMEOUT_SECONDS=10
