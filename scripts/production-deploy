#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file=${PORTAL_COMPOSE_FILE:-"$repository_root/compose.production.yaml"}
compose_override_file=${PORTAL_COMPOSE_OVERRIDE_FILE:-}
export PORTAL_ENV_FILE=${PORTAL_ENV_FILE:-"$repository_root/deploy/production.env"}
export PORTAL_MIGRATION_ENV_FILE=${PORTAL_MIGRATION_ENV_FILE:-"$repository_root/deploy/migration.env"}
export PORTAL_DATABASE_ADMIN_ENV_FILE=${PORTAL_DATABASE_ADMIN_ENV_FILE:-"$repository_root/deploy/database-admin.env"}
export PORTAL_MAINTENANCE_ENV_FILE=${PORTAL_MAINTENANCE_ENV_FILE:-"$repository_root/deploy/maintenance.env"}
export PORTAL_BIND_ADDRESS=${PORTAL_BIND_ADDRESS:-127.0.0.1}
deployment_lock_file=${PORTAL_DEPLOY_LOCK_FILE:-/var/lock/carlos-patient-portal-deploy.lock}

usage() {
  cat <<'EOF'
Usage: scripts/production-deploy COMMAND

Commands:
  validate          Validate files, the immutable image reference, and Compose configuration
  migrate           Upgrade PostgreSQL with the schema-owner role
  apply-db-policy   Reapply least-privilege and append-only audit grants
  preflight         Verify production policy, PostgreSQL TLS/schema, and runtime privileges
  deploy            Migrate, apply grants, pass preflight, start services, and verify readiness
  readiness         Query the authenticated readiness endpoint from inside the web container
  outbox-status     Report queued, leased, delivered, and terminal outbound work
  export-audit      Export JSONL; accepts optional AFTER_ID and BATCH_SIZE
  cleanup-auth      Delete expired auth data; accepts optional RETENTION_DAYS
  prune-audit       Prune one approved retention batch with the maintenance role
  status            Show the deployment processes
  rollback          Restart web/worker with PORTAL_ROLLBACK_IMAGE; never downgrades the database
EOF
}

compose() {
  if [ -n "$compose_override_file" ]; then
    docker compose --file "$compose_file" --file "$compose_override_file" "$@"
  else
    docker compose --file "$compose_file" "$@"
  fi
}

require_file() {
  if [ ! -f "$1" ]; then
    printf 'Required file is missing: %s\n' "$1" >&2
    exit 1
  fi
}

require_private_file() {
  require_file "$1"
  if find "$1" -prune -perm /077 -print | grep -q .; then
    printf 'Secret environment file must not be accessible by group or others: %s\n' "$1" >&2
    exit 1
  fi
}

is_digest_reference() {
  case "$1" in
    *@sha256:*) digest=${1##*@sha256:} ;;
    *) return 1 ;;
  esac
  printf '%s' "$digest" | grep -Eq '^[0-9a-f]{64}$'
}

require_image() {
  if [ -z "${PORTAL_IMAGE:-}" ]; then
    printf '%s\n' 'PORTAL_IMAGE must name the release image.' >&2
    exit 1
  fi
  if ! is_digest_reference "$PORTAL_IMAGE" \
    && [ "${PORTAL_ALLOW_MUTABLE_IMAGE:-}" != "true" ]; then
    printf '%s\n' 'PORTAL_IMAGE must use an immutable @sha256 digest.' >&2
    printf '%s\n' 'Set PORTAL_ALLOW_MUTABLE_IMAGE=true only for a local deployment rehearsal.' >&2
    exit 1
  fi
}

acquire_deployment_lock() {
  command -v flock >/dev/null 2>&1 || {
    printf '%s\n' 'flock is required for mutating production operations.' >&2
    exit 1
  }
  exec 9>>"$deployment_lock_file"
  if ! flock --nonblock 9; then
    printf 'Another portal operation holds the deployment lock: %s\n' \
      "$deployment_lock_file" >&2
    exit 1
  fi
}

validate() {
  command -v docker >/dev/null 2>&1 || {
    printf '%s\n' 'Docker with the Compose v2 plugin is required.' >&2
    exit 1
  }
  if [ "$PORTAL_BIND_ADDRESS" != "127.0.0.1" ]; then
    printf '%s\n' 'PORTAL_BIND_ADDRESS must be 127.0.0.1 in production.' >&2
    exit 1
  fi
  require_image
  if [ -n "$compose_override_file" ]; then
    require_file "$compose_override_file"
  fi
  require_private_file "$PORTAL_ENV_FILE"
  require_private_file "$PORTAL_MIGRATION_ENV_FILE"
  require_private_file "$PORTAL_DATABASE_ADMIN_ENV_FILE"
  require_private_file "$PORTAL_MAINTENANCE_ENV_FILE"
  if [ -z "${PORTAL_DB_CA_FILE:-}" ]; then
    printf '%s\n' 'PORTAL_DB_CA_FILE must name the PostgreSQL CA certificate.' >&2
    exit 1
  fi
  require_file "${PORTAL_DB_CA_FILE:-}"
  compose --profile operations config --quiet
}

readiness_once() {
  compose exec -T web python -c \
    'from urllib.request import Request, urlopen; from carlos_patient_portal.config import get_settings; token=get_settings().internal_health_token.get_secret_value(); request=Request("http://127.0.0.1:8090/internal/readiness", headers={"Authorization": "Bearer "+token}); response=urlopen(request, timeout=5); print(response.read().decode())'
}

wait_for_readiness() {
  attempt=1
  while [ "$attempt" -le 30 ]; do
    if readiness_once; then
      return 0
    fi
    sleep 2
    attempt=$((attempt + 1))
  done
  printf '%s\n' 'Portal did not become ready within 60 seconds.' >&2
  compose logs --tail 100 web >&2
  return 1
}

command_name=${1:-}
case "$command_name" in
  migrate|apply-db-policy|deploy|export-audit|cleanup-auth|prune-audit|rollback)
    acquire_deployment_lock
    ;;
esac

case "$command_name" in
  validate)
    validate
    ;;
  migrate)
    validate
    compose --profile operations run --rm migrate
    ;;
  apply-db-policy)
    validate
    compose --profile operations run --rm database-policy
    ;;
  preflight)
    validate
    compose --profile operations run --rm preflight
    ;;
  deploy)
    validate
    compose --profile operations run --rm migrate
    compose --profile operations run --rm database-policy
    compose --profile operations run --rm preflight
    compose up --detach --no-build --remove-orphans --wait --wait-timeout 90 web outbox
    wait_for_readiness
    ;;
  readiness)
    require_image
    readiness_once
    ;;
  outbox-status)
    validate
    require_private_file "$PORTAL_MAINTENANCE_ENV_FILE"
    compose --profile operations run --rm maintenance outbox-status
    ;;
  export-audit)
    validate
    require_private_file "$PORTAL_MAINTENANCE_ENV_FILE"
    after_id=${2:-0}
    batch_size=${3:-1000}
    case "$after_id:$batch_size" in
      *[!0-9:]*) printf '%s\n' 'AFTER_ID and BATCH_SIZE must be non-negative integers.' >&2; exit 2 ;;
    esac
    compose --profile operations run --rm maintenance \
      export-audit --after-id "$after_id" --batch-size "$batch_size"
    ;;
  cleanup-auth)
    validate
    require_private_file "$PORTAL_MAINTENANCE_ENV_FILE"
    retention_days=${2:-30}
    case "$retention_days" in
      *[!0-9]*) printf '%s\n' 'RETENTION_DAYS must be a non-negative integer.' >&2; exit 2 ;;
    esac
    compose --profile operations run --rm maintenance \
      cleanup-transient-auth --retention-days "$retention_days"
    ;;
  prune-audit)
    validate
    require_private_file "$PORTAL_MAINTENANCE_ENV_FILE"
    compose --profile operations run --rm audit-maintenance prune-audit
    ;;
  status)
    require_image
    compose ps
    ;;
  rollback)
    validate
    if [ -z "${PORTAL_ROLLBACK_IMAGE:-}" ]; then
      printf '%s\n' 'PORTAL_ROLLBACK_IMAGE must name the previous immutable image digest.' >&2
      exit 1
    fi
    if ! is_digest_reference "$PORTAL_ROLLBACK_IMAGE"; then
      printf '%s\n' 'PORTAL_ROLLBACK_IMAGE must use an immutable @sha256 digest.' >&2
      exit 1
    fi
    PORTAL_IMAGE=$PORTAL_ROLLBACK_IMAGE
    export PORTAL_IMAGE
    compose up --detach --no-build --wait --wait-timeout 90 web outbox
    wait_for_readiness
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
